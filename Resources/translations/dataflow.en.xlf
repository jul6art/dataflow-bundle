<?xml version="1.0" encoding="UTF-8"?>
<!--
    The bundle ships the two keys its boolean transformer reads, in its OWN domain.

    ⚠️ The domain is `dataflow`, never `messages`. A bundle that hard-codes `messages` forces each
    of its consumers to break the rule this ecosystem enforces — translations split by functional
    domain, `messages` never a dumping ground. `datatable-bundle` had to gain a configurable domain
    after the fact, and 165 lines of catalogue moved with it.

    ⚠️ XLIFF rather than YAML, and English rather than French: a published package's default
    catalogue is the one a consumer overrides, so it has to be the neutral one. A French consumer
    ships `dataflow.fr.yaml` in its own `translations/` and Symfony merges it over this.
-->
<xliff xmlns="urn:oasis:names:tc:xliff:document:1.2" version="1.2">
    <file source-language="en" target-language="en" datatype="plaintext" original="dataflow">
        <body>
            <trans-unit id="dataflow.value.yes" resname="dataflow.value.yes">
                <source>dataflow.value.yes</source>
                <target>Yes</target>
            </trans-unit>
            <trans-unit id="dataflow.value.no" resname="dataflow.value.no">
                <source>dataflow.value.no</source>
                <target>No</target>
            </trans-unit>
            <trans-unit id="dataflow.import.error.file_unreadable" resname="dataflow.import.error.file_unreadable">
                <source>dataflow.import.error.file_unreadable</source>
                <target>The file could not be opened.</target>
            </trans-unit>
            <trans-unit id="dataflow.import.error.empty_file" resname="dataflow.import.error.empty_file">
                <source>dataflow.import.error.empty_file</source>
                <target>The file is empty.</target>
            </trans-unit>
            <trans-unit id="dataflow.import.error.binary_spreadsheet" resname="dataflow.import.error.binary_spreadsheet">
                <source>dataflow.import.error.binary_spreadsheet</source>
                <target>This is a spreadsheet, not a text file. Save it as CSV and upload it again.</target>
            </trans-unit>
            <trans-unit id="dataflow.import.error.row_cap_reached" resname="dataflow.import.error.row_cap_reached">
                <source>dataflow.import.error.row_cap_reached</source>
                <target>The file exceeds the maximum number of rows; the rest was not read.</target>
            </trans-unit>
            <trans-unit id="dataflow.import.error.duplicate" resname="dataflow.import.error.duplicate">
                <source>dataflow.import.error.duplicate</source>
                <target>This record already exists.</target>
            </trans-unit>
            <trans-unit id="dataflow.import.error.batch_failed" resname="dataflow.import.error.batch_failed">
                <source>dataflow.import.error.batch_failed</source>
                <target>The import stopped: a batch could not be written.</target>
            </trans-unit>
        </body>
    </file>
</xliff>
